<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template src="ClueBoard.uxml" name="ClueBoardTemplate" />
    <Style src="project://database/Assets/UI%20Toolkit/GameUI.uss?fileID=7433441132597879392&amp;guid=6158622be15bce24db8d826768ef4278&amp;type=3#GameUI"/>
    <ui:VisualElement name="root" class="root" style="background-color: rgba(0, 0, 0, 0);">
        <!-- Scene background — bottommost layer, swapped by DialogueManager -->
        <ui:VisualElement name="scene-bg" class="scene-bg" />
        <!-- Vignette — purely CSS, always on top of scene-bg -->
        <ui:VisualElement name="vignette-overlay" class="vignette-overlay" picking-mode="Ignore" />
        <!-- Atmosphere — slow CRT scanline sweep -->
        <ui:VisualElement class="scanline-sweep" picking-mode="Ignore" />
        <ui:VisualElement name="header" class="header">
            <ui:Button name="burger-menu-button" class="icon-button">
                <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/Textures/Graphics/icons/UI_BurgerMenu.png');"/>
            </ui:Button>
            <ui:VisualElement class="header-right">
                <ui:Button name="erd-button" class="icon-button" tooltip="View Database ERD">
                    <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/Textures/Graphics/icons/UI_ERD.png');"/>
                </ui:Button>
                <ui:Button name="history-button" class="icon-button" tooltip="Dialogue History">
                    <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/Textures/Graphics/icons/UI_History.png');"/>
                </ui:Button>
                <ui:Button name="tutorial-button" class="icon-button">
                    <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/Textures/Graphics/icons/UI_Question.png');"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="burger-menu-dropdown" class="burger-menu-dropdown">
            <ui:Button tooltip="Toggle Sound" name="mute-button" class="menu-button">
                <ui:VisualElement name="mute-icon" class="btn-icon mute-icon-on"/>
            </ui:Button>
            <ui:Button name="text-size-button" class="icon-button" tooltip="Text Size">
                <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/Textures/Graphics/icons/UI_FontSize.png');"/>
            </ui:Button>
            <ui:Button tooltip="Detective Profile" name="profile-button" class="menu-button">
                <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/Textures/Graphics/icons/UI_Profile.png');"/>
            </ui:Button>
            <ui:Button tooltip="Found Clues" name="clues-button" class="menu-button">
                <ui:VisualElement class="btn-icon" style="background-image: url('project://database/Assets/Textures/Graphics/icons/UI_ClueBoard.png');"/>
            </ui:Button>
            <ui:Button text="SQL" tooltip="SQL Command Line Menu" name="sql-menu-button" enabled="true" class="menu-button sql-button"/>
            <ui:Button text="EXIT" tooltip="Save and return to main menu" name="save-exit-button" class="menu-button save-exit-button"/>
        </ui:VisualElement>

        <!-- ═══ CUTSCENE OVERLAY ════════════════════════════════════════════ -->
        <ui:VisualElement name="cutscene-layer" class="cutscene-layer">
            <ui:Label name="cutscene-text" class="cutscene-text" text="" />
            <ui:Button name="cutscene-continue" class="cutscene-continue" text="[ Continue ]" />
        </ui:VisualElement>

        <!-- ═══ VN DIALOGUE LAYER ════════════════════════════════════════════ -->
        <ui:VisualElement name="dialogue-layer" class="dialogue-layer">
            <ui:VisualElement name="speaker-portrait" class="speaker-portrait" picking-mode="Ignore" />
            <ui:VisualElement name="dialogue-box" class="dialogue-box">
                <ui:Label name="speaker-name" class="speaker-name" text="" />
                <ui:Label name="dialogue-text" class="dialogue-text" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ═══ INVENTORY PANEL ══════════════════════════════════════════════ -->
        <ui:VisualElement name="inventory-panel" class="inventory-panel">
            <ui:Label text="EVIDENCE" class="inventory-title" />
            <ui:ScrollView name="inventory-list" class="inventory-list" />
            <ui:Button name="add-to-board-btn" class="inventory-action-btn" text="Pin to Board" />
            <ui:Button name="close-inventory-btn" class="inventory-action-btn" text="Close" />
        </ui:VisualElement>

        <!-- SQL Terminal -->
        <ui:VisualElement name="sql-terminal-container" style="position: absolute; top: 103px; left: 0; right: 0; bottom: 0; flex-direction: column; display: none;">
            <ui:VisualElement name="task-banner" class="task-banner">
                <ui:Label name="task-label" class="task-label" text="" />
                <ui:Button name="debbie-hint-btn" class="debbie-hint-btn" text="? Ask Debbie" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                <ui:VisualElement name="querie-input-menu" class="sql-input-panel" style="flex-grow: 1; flex-basis: 0; flex-direction: column;">
                    <ui:VisualElement class="sql-input-row" style="flex-direction: row; width: 100%; height: 160px; flex-shrink: 0;">
                        <ui:TextField label="" multiline="true" placeholder-text="put your queries here" name="query-input-field" class="sql-input-field" style="flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0;"/>
                        <ui:Button text="Send" name="send-query-button" class="sql-send-btn" style="flex-shrink: 0;"/>
                    </ui:VisualElement>
                    <ui:ListView name="command-history-list" class="sql-history-list" style="flex-grow: 1; width: 100%;"/>
                </ui:VisualElement>
                <ui:VisualElement name="query-output-panel" class="sql-output-panel" style="flex-grow: 1; flex-basis: 0;">
                    <ui:ScrollView style="flex-grow: 1; width: 100%; height: 100%;">
                        <ui:Label name="query-output-text" class="sql-output-text" text="Query results will appear here." style="padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;"/>
                    </ui:ScrollView>
                    <ui:VisualElement name="task-stamp" class="task-stamp" picking-mode="Ignore">
                        <ui:Label name="task-stamp-label" class="task-stamp-label" text="VERIFIED" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
             <!-- ═══ DEBBIE HINT POPUP ════════════════════════════════════════════ -->
        <ui:VisualElement name="hint-popup" class="hint-popup">
            <ui:Label name="hint-popup-speaker" class="hint-popup-speaker" text="Debbie" />
            <ui:Label name="hint-popup-text" class="hint-popup-text" text="" />
            <ui:Button name="hint-popup-close" class="hint-popup-close" text="Got it, cluck!" />
        </ui:VisualElement>
        </ui:VisualElement>

        <!-- Black fade -->
        <ui:VisualElement name="scene-fade" class="scene-fade" picking-mode="Ignore" />

        <!-- ═══ CLUE BOARD — last child of root so BringToFront() works ═══ -->
        <ui:Instance template="ClueBoardTemplate" name="clue-board-instance" picking-mode="Ignore" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none;" />

    </ui:VisualElement>

    <!-- ERD OVERLAY -->
    <ui:VisualElement name="erd-overlay" style="display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(22,14,6,0.97); flex-direction: column;">
        <ui:VisualElement name="erd-header" style="flex-direction: row; align-items: center; padding: 10px 16px; background-color: rgba(38,24,8,1); flex-shrink: 0; border-bottom-width: 2px; border-bottom-color: rgb(140,100,28);">
            <ui:Label text="DATABASE DIAGRAM" style="flex-grow: 1; font-size: 14px; color: rgb(140,100,28); -unity-font-style: bold;" />
            <ui:Label name="erd-zoom-label" text="100%" style="font-size: 12px; color: rgb(100,72,22); margin-right: 16px;" />
            <ui:Button name="erd-close-btn" text="" style="width: 44px; height: 44px; background-image: url('project://database/Assets/Textures/actual%20assets/clue%20board/Untitled39_0000s_0000_Button-Close.png?fileID=2800000&amp;guid=653d1e86460b90649bc7cbc2b3bb651b&amp;type=3#Untitled39_0000s_0000_Button-Close'); -unity-background-scale-mode: scale-to-fit; background-color: rgba(0,0,0,0); border-width: 0;" />
        </ui:VisualElement>
        <ui:VisualElement name="erd-canvas-root" style="flex-grow: 1; overflow: hidden;">
            <ui:VisualElement name="erd-canvas" style="position: absolute; left: 0; top: 0;">
                <ui:VisualElement name="erd-lines-layer" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
                <ui:VisualElement name="erd-tables-layer" style="position: absolute; left: 0; top: 0;" />
                <ui:VisualElement name="erd-labels-layer" style="position: absolute; left: 0; top: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- TUTORIAL OVERLAY -->
    <ui:VisualElement name="tutorial-overlay" style="display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(12,8,4,0.97); flex-direction: column;">
        <ui:VisualElement class="tutorial-header">
            <ui:Label text="DETECTIVE'S HANDBOOK" class="tutorial-title" />
            <ui:Button name="tutorial-close-btn" text="" class="tutorial-close-btn" />
        </ui:VisualElement>
        <ui:ScrollView class="tutorial-scroll" style="flex-grow: 1;">
            <ui:VisualElement class="tutorial-content">
                <ui:Label text="THE BASICS" class="tutorial-section-title" />
                <ui:Label text="You are a Time Hound — a detective with query abilities, sent to investigate cold cases across time." class="tutorial-body" />
                <ui:Label text="Advance dialogue by clicking [ Continue ]. SQL task nodes must be solved before the story moves forward." class="tutorial-body" />
                <ui:Label text="Progress saves automatically. Exit and return any time — you will resume exactly where you left off." class="tutorial-body" />
                <ui:VisualElement class="tutorial-divider" />
                <ui:Label text="BUTTONS" class="tutorial-section-title" />
                <ui:VisualElement class="tutorial-row">
                    <ui:Label text="Burger Menu" class="tutorial-key" />
                    <ui:Label text="Opens the toolbar row — sound, text size, profile, SQL terminal, and exit." class="tutorial-val" />
                </ui:VisualElement>
                <ui:VisualElement class="tutorial-row">
                    <ui:Label text="Sound" class="tutorial-key" />
                    <ui:Label text="Toggles all game audio on or off." class="tutorial-val" />
                </ui:VisualElement>
                <ui:VisualElement class="tutorial-row">
                    <ui:Label text="Text Size" class="tutorial-key" />
                    <ui:Label text="Cycles dialogue and SQL text through Normal → Large → XL." class="tutorial-val" />
                </ui:VisualElement>
                <ui:VisualElement class="tutorial-row">
                    <ui:Label text="Profile" class="tutorial-key" />
                    <ui:Label text="Your detective profile — name and active case status." class="tutorial-val" />
                </ui:VisualElement>
                 <ui:VisualElement class="tutorial-row">
                    <ui:Label text="Clue Board" class="tutorial-key" />
                    <ui:Label text="Can be used by the player to make notes on the case." class="tutorial-val" />
                </ui:VisualElement>
                <ui:VisualElement class="tutorial-row">
                    <ui:Label text="SQL" class="tutorial-key" />
                    <ui:Label text="Opens the Timecase — your SQL terminal for querying the case database." class="tutorial-val" />
                </ui:VisualElement>
                <ui:VisualElement class="tutorial-row">
                    <ui:Label text="EXIT" class="tutorial-key" />
                    <ui:Label text="Saves your progress and returns to the main menu." class="tutorial-val" />
                </ui:VisualElement>
                <ui:VisualElement class="tutorial-row">
                    <ui:Label text="ERD Diagram" class="tutorial-key" />
                    <ui:Label text="Shows the full database schema — table names, columns, and how they link together." class="tutorial-val" />
                </ui:VisualElement>
                 <ui:VisualElement class="tutorial-row">
                    <ui:Label text="Dialogue Log" class="tutorial-key" />
                    <ui:Label text="Logs all of the current and previous dialogue." class="tutorial-val" />
                </ui:VisualElement>
                <ui:VisualElement class="tutorial-row">
                    <ui:Label text="? This page" class="tutorial-key" />
                    <ui:Label text="You are reading it right now." class="tutorial-val" />
                </ui:VisualElement>
                <ui:VisualElement class="tutorial-divider" />
                <ui:Label text="THE TIMECASE  (SQL TERMINAL)" class="tutorial-section-title" />
                <ui:Label text="Type your query in the left panel and press Send or Ctrl + Enter to run it." class="tutorial-body" />
                <ui:Label text="Results appear on the right panel. A task is solved when your output matches what the case expects — a green VERIFIED stamp will appear." class="tutorial-body" />
                <ui:Label text="Click any entry in the history list (below the input field) to recall a past command." class="tutorial-body" />
                <ui:Label text="The task banner at the top always shows what you need to find." class="tutorial-body" />
                <ui:VisualElement class="tutorial-divider" />
                <ui:Label text="ASKING FOR HELP" class="tutorial-section-title" />
                <ui:Label text="Debbie will pop up with a hint after 30 seconds of inactivity on a SQL task." class="tutorial-body" />
                <ui:Label text="You can also click  ? Ask Debbie  in the task banner at any time for an immediate nudge." class="tutorial-body" />
                <ui:VisualElement class="tutorial-divider" />
                <ui:Label text="ABOUT THE CASE" class="tutorial-section-title" />
                <ui:Label text="The Somerton Man was found on Somerton Beach, Adelaide, on December 1, 1948. No identification. No cause of death. A torn scrap of paper in a hidden pocket reading 'Tamam Shud' — Persian for 'It is ended.'" class="tutorial-body" />
                <ui:Label text="The case was never officially solved. Your job is to investigate it using the Time Travel Agency's database and see how far you get." class="tutorial-body" />
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>

    <!-- DIALOGUE HISTORY OVERLAY -->
<ui:VisualElement name="history-overlay" style="display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(6,4,2,0.95); flex-direction: column;">
    <ui:VisualElement class="history-header">
        <ui:Label text="DIALOGUE HISTORY" class="history-title" />
        <ui:Button name="history-close-btn" text="" class="tutorial-close-btn" />
    </ui:VisualElement>
    <ui:ScrollView name="history-scroll" class="history-scroll" style="flex-grow: 1;">
        <ui:VisualElement name="history-content" class="history-content" />
    </ui:ScrollView>
</ui:VisualElement>

    <!-- PROFILE OVERLAY -->
    <ui:VisualElement name="profile-overlay" style="display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(6,4,2,0.92); align-items: center; justify-content: center; flex-direction: column;">
        <ui:VisualElement class="profile-card">
            <ui:VisualElement class="profile-left">
                <ui:VisualElement class="profile-avatar" />
                <ui:Label name="profile-n-name" text="DETECTIVE" class="profile-avatar-name" />
                <ui:Label text="● Active — On Case" class="profile-avatar-status" />
            </ui:VisualElement>
            <ui:VisualElement class="profile-vdivider" />
            <ui:VisualElement class="profile-right">
                <ui:Label text="DETECTIVE DOSSIER" class="profile-dossier-title" />
                <ui:VisualElement class="profile-info-row">
                    <ui:Label text="Affiliation" class="profile-info-key" />
                    <ui:Label text="Time Travel Agency" class="profile-info-val" />
                </ui:VisualElement>
                <ui:VisualElement class="profile-info-row">
                    <ui:Label text="Rank" class="profile-info-key" />
                    <ui:Label text="A-Rank  (Query Certified)" class="profile-info-val" />
                </ui:VisualElement>
                <ui:VisualElement class="profile-info-row">
                    <ui:Label text="Active Case" class="profile-info-key" />
                    <ui:Label text="Murder of the Somerton Man — Adelaide, 1948" class="profile-info-val" />
                </ui:VisualElement>
                <ui:VisualElement class="profile-info-row">
                    <ui:Label text="Partner" class="profile-info-key" />
                    <ui:Label text="Debbie  (30% cut)" class="profile-info-val" />
                </ui:VisualElement>
                <ui:VisualElement class="profile-info-row">
                    <ui:Label text="Reward Cut" class="profile-info-key" />
                    <ui:Label text="70%" class="profile-info-val" />
                </ui:VisualElement>
                <ui:VisualElement class="profile-notes-divider" />
                <ui:Label text="Field Notes" class="profile-notes-title" />
                <ui:Label text="Arrived hungry. Acquired a talking chicken somehow. Survived a locked room mid-investigation. Shows genuine aptitude for query work despite claiming otherwise. Motivation: possibly the $200,000, possibly pride." class="profile-notes-body" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="profile-close-btn" text="[ Dismiss ]" class="profile-close-btn" />
    </ui:VisualElement>

</ui:UXML>
