.root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: flex-start;
    flex-direction: column;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf?fileID=12800000&guid=22008c9a3075d60409697e3fe420a2d2&type=3#SpecialElite");
}

.bg-layer {
    position: absolute;
    left: -40px;
    top: -40px;
    right: -40px;
    bottom: -40px;
    background-image: url("project://database/Assets/Textures/actual%20assets/mainscreen/Untitled39_0002s_0003_Main-Menu-Screen.png?fileID=2800000&guid=ffdcb08bcb8ab824ba5b2de34a8b1630&type=3#Untitled39_0002s_0003_Main-Menu-Screen");
    -unity-background-scale-mode: scale-and-crop;
}

.bg-tint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.52);
}

.logo-wrap {
    width: 620px;
    height: 186px;
    margin-top: 22px;
    margin-bottom: 0;
}

.logo-shadow {
    position: absolute;
    left: 0;
    top: 12px;
    width: 620px;
    height: 186px;
    background-image: url("project://database/Assets/Textures/actual%20assets/mainscreen/Untitled39_0002s_0002_Logo-Main-Menu-Shadow.png?fileID=2800000&guid=47b19c7c7a35f264d80ff075a4c16c3d&type=3#Untitled39_0002s_0002_Logo-Main-Menu-Shadow");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.5;
}

.logo {
    position: absolute;
    left: 0;
    top: 0;
    width: 620px;
    height: 186px;
    background-image: url("project://database/Assets/Textures/actual%20assets/mainscreen/Untitled39_0002s_0001_Logo-Main-Menu.png?fileID=2800000&guid=6f50584856cf9244ab52df0a841293e4&type=3#Untitled39_0002s_0001_Logo-Main-Menu");
    -unity-background-scale-mode: scale-to-fit;
}

.screen-title {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf?fileID=12800000&guid=22008c9a3075d60409697e3fe420a2d2&type=3#SpecialElite");
    font-size: 12px;
    color: rgb(237, 224, 200);
    letter-spacing: 7px;
    -unity-text-align: upper-center;
    margin-top: 0;
    margin-bottom: 10px;
}

.divider {
    display: none;
}

.profile-scroll {
    flex-grow: 1;
    width: 620px;
    max-height: 320px;
    flex-shrink: 1;
}

.profile-list {
    flex-direction: column;
    width: 100%;
    padding-bottom: 8px;
}

/* Hide all scrollbar chrome */
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.unity-scroll-view__vertical-scroller,
.unity-scroll-view__horizontal-scroller {
    display: none;
}

.unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
}

.unity-base-slider__dragger {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-scroller {
    width: 0;
    height: 0;
    min-width: 0;
    min-height: 0;
}

.no-profiles-label {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf?fileID=12800000&guid=22008c9a3075d60409697e3fe420a2d2&type=3#SpecialElite");
    font-size: 11px;
    color: rgba(237, 224, 200, 0.55);
    -unity-text-align: middle-center;
    margin-top: 28px;
    letter-spacing: 1px;
    display: none;
}

.profile-card {
    flex-direction: row;
    align-items: center;
    background-image: url("project://database/Assets/Textures/actual%20assets/clue%20board/Untitled39_0000s_0006_Panel-For-Close_Open_Add-options.png?fileID=2800000&guid=c829aaece565f9d4991c628fd6d9e943&type=3#Untitled39_0000s_0006_Panel-For-Close_Open_Add-options");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 22px;
    padding-right: 22px;
    margin-bottom: 8px;
    width: 100%;
    scale: 1;
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.15s, 0.15s;
    transition-timing-function: ease-out, ease-out;
}

.profile-card:hover {
    scale: 1.02;
    -unity-background-image-tint-color: rgb(255, 240, 200);
}

.profile-card:active {
    scale: 0.99;
}

.card-left {
    flex-direction: row;
    align-items: center;
    width: 200px;
    flex-shrink: 0;
}

.card-name {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf?fileID=12800000&guid=22008c9a3075d60409697e3fe420a2d2&type=3#SpecialElite");
    font-size: 13px;
    color: rgb(195, 155, 72);
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.card-right {
    flex-direction: column;
    flex-grow: 1;
    margin-left: 18px;
}

.card-case {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf?fileID=12800000&guid=22008c9a3075d60409697e3fe420a2d2&type=3#SpecialElite");
    font-size: 10px;
    color: rgb(237, 224, 220);
    margin-bottom: 4px;
}

.card-date {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf?fileID=12800000&guid=22008c9a3075d60409697e3fe420a2d2&type=3#SpecialElite");
    font-size: 8px;
    color: rgb(175, 162, 148);
}

/* delete x */
.card-delete {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf?fileID=12800000&guid=22008c9a3075d60409697e3fe420a2d2&type=3#SpecialElite");
    font-size: 20px;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(150, 46, 46, 0.64);
    border-width: 0;
    padding: 4px 10px;
    margin-left: 12px;
    flex-shrink: 0;
    scale: 1;
    transition-property: color, scale;
    transition-duration: 0.12s, 0.12s;
    transition-timing-function: ease-out, ease-out;
}

.card-delete:hover {
    color: rgb(220, 90, 80);
    scale: 1.18;
}

.card-delete:active {
    scale: 0.92;
}

/* back button */
.back-btn {
    width: 390px;
    height: 76px;
    padding: 0;
    font-size: 25px;
    letter-spacing: 4px;
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf?fileID=12800000&guid=22008c9a3075d60409697e3fe420a2d2&type=3#SpecialElite");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(48, 28, 14);
    background-image: url("project://database/Assets/Textures/actual%20assets/mainscreen/Untitled39_0002s_0005_Speech-Bubble.png?fileID=2800000&guid=e2c4f87c83c17a44296424af44d9b995&type=3#Untitled39_0002s_0005_Speech-Bubble");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    margin-top: 10px;
    margin-bottom: 24px;
    rotate: 1.4deg;
    scale: 1;
    transition-property: scale, rotate, -unity-background-image-tint-color, color;
    transition-duration: 0.22s, 0.22s, 0.22s, 0.22s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}

.back-btn:hover {
    scale: 1.06;
    rotate: 0deg;
    -unity-background-image-tint-color: rgb(255, 244, 210);
    color: rgb(25, 10, 2);
}

.back-btn:active {
    scale: 0.96;
    rotate: 0deg;
    -unity-background-image-tint-color: rgb(195, 178, 148);
}
