<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
    editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/ClueBoard.uss"/>

    <!-- Root — hidden by default, shown by ClueBoardManager.SetVisible(true) -->
    <ui:VisualElement name="cb-root" class="cb-root" picking-mode="Ignore">

        <!-- Blackboard background image (clueboard_bg.png applied in C#) -->
        <ui:VisualElement name="board-bg" class="cb-board-bg">

            <!-- Top action bar — close, add note, open inventory -->
            <ui:VisualElement name="action-bar-bg" class="cb-action-bar">
                <ui:Button name="close-btn"    class="cb-icon-btn" tooltip="Close board" />
                <ui:Button name="add-note-btn" class="cb-icon-btn" tooltip="Add note" />
                <ui:Button name="inventory-btn" class="cb-icon-btn" tooltip="Open inventory tray" />
            </ui:VisualElement>

            <!-- Canvas where cards and ropes live -->
            <ui:VisualElement name="cards-layer" class="cb-cards-layer">
                <!-- Rope drawing layer — sits below cards, draws via generateVisualContent -->
                <ui:VisualElement name="rope-layer" class="cb-rope-layer" picking-mode="Ignore" />
            </ui:VisualElement>

            <!-- Card action bar — appears above a selected card -->
            <ui:VisualElement name="card-actions" class="cb-card-actions">
                <ui:Button name="action-delete"   class="cb-action-btn" tooltip="Delete" />
                <ui:Button name="action-edit"     class="cb-action-btn" tooltip="Edit note" />
                <ui:Button name="action-rope"     class="cb-action-btn" tooltip="Connect rope" />
                <ui:Button name="action-rotate-l" class="cb-action-btn" tooltip="Rotate left" />
                <ui:Button name="action-rotate-r" class="cb-action-btn" tooltip="Rotate right" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Inventory tray — slides in from the right -->
        <ui:VisualElement name="inventory-tray" class="cb-inventory-tray inventory-tray--closed">
            <ui:Label text="EVIDENCE" class="cb-tray-title" />
            <ui:ScrollView name="tray-scroll" class="cb-tray-scroll" />
            <ui:Button name="tray-close" text="Close" class="cb-tray-close" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
