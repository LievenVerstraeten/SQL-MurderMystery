<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/NewGameSetup.uss"/>
    <ui:VisualElement name="root" class="root">

        <!-- Background layer — oversized so parallax shift never shows an edge -->
        <ui:VisualElement name="bg-layer" class="bg-layer" />

        <!-- Title art — positioned top-left, fades in via CaseIntroManager -->
        <ui:VisualElement name="title-img" class="title-img" />

        <!-- Hidden label kept so CaseIntroManager.Q<Label>("CaseTitle") doesn't error -->
        <ui:Label name="CaseTitle" class="case-title-hidden" text="" />

        <!-- Name input + proceed button — centred, parallax layer 3 -->
        <ui:VisualElement name="input-area" class="input-area">
            <ui:VisualElement name="name-box" class="name-box">
                <ui:TextField label="" placeholder-text="Enter your detective name..." name="FieldPlayerName" class="name-field" />
            </ui:VisualElement>
            <ui:Button text="PROCEED" name="PlayerConfirmName" class="proceed-btn" />
        </ui:VisualElement>

        <!-- Back to main menu — bottom-left -->
        <ui:Button text="← Main Menu" name="BackButton" class="back-btn" />

    </ui:VisualElement>
</ui:UXML>
