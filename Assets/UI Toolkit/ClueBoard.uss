/* ClueBoard.uss
   Styles for the clue board overlay.
   Asset textures (background images) are applied in C# by ClueBoardManager.
   These rules handle layout, positioning, and sizing only.
*/

/* ── Root ─────────────────────────────────────────────────────────────────── */

.cb-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    flex-direction: row;
}

/* ── Board background ─────────────────────────────────────────────────────── */

.cb-board-bg {
    flex-grow: 1;
    flex-direction: column;
    background-size: 100% 100%;  /* stretch clueboard_bg.png to fill */
    overflow: hidden;
    margin: 20px;
    border-radius: 8px;
}

/* ── Top action bar ───────────────────────────────────────────────────────── */

.cb-action-bar {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 8px 12px;
    height: 60px;
    flex-shrink: 0;
    background-size: 100% 100%;
}

.cb-icon-btn {
    width: 44px;
    height: 44px;
    margin-right: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 22px;
    background-size: contain;
    -unity-background-scale-mode: scale-to-fit;
}

.cb-icon-btn:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.cb-icon-btn--active {
    background-color: rgba(255, 255, 255, 0.25);
}

/* ── Cards layer ──────────────────────────────────────────────────────────── */

.cb-cards-layer {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
}

/* ── Rope layer ───────────────────────────────────────────────────────────── */

.cb-rope-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ── Board cards (note.png applied as background in C#) ───────────────────── */

.board-card {
    position: absolute;
    width: 180px;
    height: 200px;
    background-size: 100% 100%;
    overflow: hidden;
    cursor: link;
}

.board-card--selected {
    opacity: 0.85;
}

.card-pin {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: 18px;
    height: 18px;
}

.card-title {
    position: absolute;
    top: 36px;
    left: 14px;
    right: 14px;
    font-size: 11px;
    color: rgb(38, 26, 13);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 4px;
}

.card-body {
    position: absolute;
    top: 56px;
    left: 14px;
    right: 14px;
    bottom: 10px;
    font-size: 10px;
    color: rgb(51, 36, 18);
    white-space: normal;
    overflow: hidden;
}

/* ── Card action bar ──────────────────────────────────────────────────────── */

.cb-card-actions {
    position: absolute;
    flex-direction: row;
    align-items: center;
    background-color: rgba(30, 22, 12, 0.88);
    border-radius: 6px;
    padding: 4px 6px;
    display: none;
}

.cb-action-btn {
    width: 36px;
    height: 36px;
    margin: 0 3px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 18px;
    background-size: contain;
    -unity-background-scale-mode: scale-to-fit;
}

.cb-action-btn:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

.cb-active {
    background-color: rgba(255, 200, 80, 0.3);
}

/* ── Inventory tray ───────────────────────────────────────────────────────── */

.cb-inventory-tray {
    width: 220px;
    flex-shrink: 0;
    flex-direction: column;
    background-color: rgb(22, 16, 8);
    border-left-width: 2px;
    border-left-color: rgb(90, 70, 40);
    padding: 12px 8px;
    transition-property: translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.inventory-tray--closed {
    translate: 220px 0;
}

.inventory-tray--open {
    translate: 0 0;
}

.cb-tray-title {
    font-size: 13px;
    color: rgb(230, 200, 80);
    -unity-font-style: bold;
    margin-bottom: 10px;
    -unity-text-align: upper-center;
}

.cb-tray-scroll {
    flex-grow: 1;
}

.cb-tray-close {
    margin-top: 8px;
    color: rgb(200, 180, 140);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(90, 70, 40);
    border-radius: 4px;
    font-size: 11px;
    padding: 6px;
}

/* ── Tray items ───────────────────────────────────────────────────────────── */

.tray-item {
    padding: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(90, 70, 40, 0.5);
    cursor: link;
}

.tray-item:hover {
    background-color: rgba(255, 200, 80, 0.1);
}

.tray-item-title {
    font-size: 11px;
    color: rgb(220, 200, 160);
    -unity-font-style: bold;
}

.tray-item-body {
    font-size: 9px;
    color: rgb(160, 140, 110);
    white-space: normal;
    margin-top: 2px;
}

/* ── Edit text field — matches note paper colour, no white box ───────────── */
.card-edit-field {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 44px;
    bottom: 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    font-size: 13px;
    color: rgb(38, 26, 13);
}

.card-edit-field > .unity-base-field__input {
    background-color: rgba(190, 178, 140, 0.35);
    border-width: 1px;
    border-color: rgba(120, 100, 60, 0.5);
    border-radius: 3px;
    color: rgb(38, 26, 13);
    font-size: 13px;
}
