/*
 * GameUI.uss — NoSQL Murder Mystery
 * Design: Gilded Mystery — Obsidian + Gold
 * Adapted from Query Hound / Gilded Enigma design system
 *
 * Palette
 *   obsidian     rgb(24, 18, 16)            scene background
 *   surface      rgb(37, 30, 28)            raised panel fill
 *   surface-hi   rgb(52, 44, 40)            elevated / hover surface
 *   gold         rgb(242, 202, 80)          primary gold accent
 *   gold-deep    rgb(212, 175, 55)          borders / active
 *   gold-light   rgb(255, 224, 136)         highlights / glow tips
 *   cream        rgb(237, 224, 220)         primary text
 *   muted        rgb(175, 162, 148)         secondary text
 *   danger       rgb(180, 65, 65)           exit / error
 */

/* Continue button — slow amber blink to draw attention */
@keyframes continue-blink {
    0%   { opacity: 1.0; }
    40%  { opacity: 1.0; }
    55%  { opacity: 0.28; }
    70%  { opacity: 1.0; }
    100% { opacity: 1.0; }
}

/* Hint popup — gentle breathing glow */
@keyframes hint-breathe {
    0%   { opacity: 1.0; }
    50%  { opacity: 0.80; }
    100% { opacity: 1.0; }
}

/* Task banner — fade in upward on appear */
@keyframes banner-rise {
    0%   { translate: 0 12px; opacity: 0; }
    100% { translate: 0   0;  opacity: 1; }
}

/* Debbie hint button — gentle pulse */
@keyframes debbie-pulse {
    0%   { opacity: 1.0; }
    50%  { opacity: 0.60; }
    100% { opacity: 1.0; }
}

/* Button entrance — bouncy pop when panel becomes visible */
@keyframes btn-pop {
    0%   { scale: 0.82; opacity: 0.5; }
    55%  { scale: 1.12; opacity: 1.0; }
    80%  { scale: 0.95; }
    100% { scale: 1.00; opacity: 1.0; }
}

/* CRT scanline — single bright band scrolling top-to-bottom */
@keyframes scanline-scroll {
    from { top: -20%; }
    to   { top: 110%; }
}

/* Typewriter cursor — sharp blink (on/off at 50%) */
@keyframes cursor-blink {
    0%   { opacity: 1; }
    49%  { opacity: 1; }
    50%  { opacity: 0; }
    99%  { opacity: 0; }
    100% { opacity: 1; }
}

/* Ink stamp — slap in, hold, fade out */
@keyframes stamp-appear {
    0%   { opacity: 0;   scale: 1.9; }
    18%  { opacity: 1;   scale: 0.93; }
    35%  { opacity: 1;   scale: 1.0; }
    72%  { opacity: 0.9; scale: 1.0; }
    100% { opacity: 0;   scale: 1.0; }
}

/* ═══════════════════════════════════════════════════════════════════
   ROOT
   ═══════════════════════════════════════════════════════════════════ */

/* ═══════════════════════════════════════════════════════════════════
   SCENE BACKGROUND + VIGNETTE + FADE
   ═══════════════════════════════════════════════════════════════════ */

.scene-bg {
    position: absolute;
    left: -20px; top: -20px; right: -20px; bottom: -20px;
    background-color: rgb(14, 10, 8);
    -unity-background-scale-mode: scale-and-crop;
}

/* 12 scene backgrounds — DialogueManager swaps these classes on scene-bg */
.bg-first-scene {
    background-image: url("project://database/Assets/Textures/actual%20assets/backgrounds/Untitled39_0003s_0003_First-Scene-Bg.png?fileID=2800000&guid=8e025c172213e4e4588797cac22f46a0&type=3#Untitled39_0003s_0003_First-Scene-Bg");
}
.bg-wormhole {
    background-image: url("project://database/Assets/Textures/actual%20assets/backgrounds/Untitled39_0003s_0011_Wormole-Bg.png?fileID=2800000&guid=9223d813842a91e40a840f9c324b9894&type=3#Untitled39_0003s_0011_Wormole-Bg");
}
.bg-somerton-beach {
    background-image: url("project://database/Assets/Textures/actual%20assets/backgrounds/Untitled39_0003s_0005_Somerton-Beach-Bg.png?fileID=2800000&guid=125b09d1d1bb26c4fab35a7f2780e8ae&type=3#Untitled39_0003s_0005_Somerton-Beach-Bg");
}
.bg-timehound {
    background-image: url("project://database/Assets/Textures/actual%20assets/backgrounds/Untitled39_0003s_0002_Somerton-Beach-Time-Hound-Bg.png?fileID=2800000&guid=f7cf0672079381a4196086e5e0f6ae96&type=3#Untitled39_0003s_0002_Somerton-Beach-Time-Hound-Bg");
}
.bg-thinking {
    background-image: url("project://database/Assets/Textures/actual%20assets/backgrounds/Untitled39_0003s_0001_Thinking_Learning-Bg.png?fileID=2800000&guid=0fa8de6e95a7e47449034cbb9d710c0c&type=3#Untitled39_0003s_0001_Thinking_Learning-Bg");
}
.bg-jessica-outside {
    background-image: url("project://database/Assets/Textures/actual%20assets/backgrounds/Untitled39_0003s_0009_Moseley-Street-Jessica-Inside-Bg.png?fileID=2800000&guid=44c6d534a48c8804f881c9d3c9adbc39&type=3#Untitled39_0003s_0009_Moseley-Street-Jessica-Inside-Bg");
}
.bg-jessica-interior {
    background-image: url("project://database/Assets/Textures/actual%20assets/backgrounds/Untitled39_0003s_0010_Jessica-Interior-Bg.png?fileID=2800000&guid=e335e98e79c20b840ab680da13a828fe&type=3#Untitled39_0003s_0010_Jessica-Interior-Bg");
}
.bg-after-jessica {
    background-image: url("project://database/Assets/Textures/actual%20assets/backgrounds/Untitled39_0003s_0012_After-Jessica-Outside-Bg.png?fileID=2800000&guid=8e280fe9932a516449a6083cefebb866&type=3#Untitled39_0003s_0012_After-Jessica-Outside-Bg");
}
.bg-escape-room {
    background-image: url("project://database/Assets/Textures/actual%20assets/backgrounds/Untitled39_0003s_0006_Escape-Room-Bg.png?fileID=2800000&guid=3f949f10ea197c5488fb165047e48ed9&type=3#Untitled39_0003s_0006_Escape-Room-Bg");
}
.bg-neil-interview {
    background-image: url("project://database/Assets/Textures/actual%20assets/backgrounds/Untitled39_0003s_0008_Neil-Halilton-Interview-Bg.png?fileID=2800000&guid=37d2e7ab30c5cf94bab8243f138d5238&type=3#Untitled39_0003s_0008_Neil-Halilton-Interview-Bg");
}
.bg-cleland {
    background-image: url("project://database/Assets/Textures/actual%20assets/backgrounds/Untitled39_0003s_0004_Uni-Lab-Cleland-Bg.png?fileID=2800000&guid=3e23bc0c06dd9e44e862320d373f2180&type=3#Untitled39_0003s_0004_Uni-Lab-Cleland-Bg");
}
.bg-coffee {
    background-image: url("project://database/Assets/Textures/actual%20assets/backgrounds/Untitled39_0003s_0007_Coffee-Momeng-Bg.png?fileID=2800000&guid=6a59f3aec0918e444ab0e468341e5839&type=3#Untitled39_0003s_0007_Coffee-Momeng-Bg");
}

/* Vignette — darkens corners for vintage atmosphere, purely decorative */
.vignette-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("project://database/Assets/Textures/actual%20assets/backgrounds/vindette%20for%20backgrounds.png?fileID=2800000&guid=dad2106eebca34f4b995bd46f9916acd&type=3#vindette%20for%20backgrounds");
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0.85;
}

/* Black screen used for fade-in/out transitions between scenes.
   Starts fully opaque (opacity 1) so the game opens to black until first bg fades in. */
.scene-fade {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 1;
}

/* ═══════════════════════════════════════════════════════════════════
   ATMOSPHERE OVERLAYS
   ═══════════════════════════════════════════════════════════════════ */

/* CSS vignette — handled by .vignette-overlay texture above; this element is kept as a hook */
.vignette-css {
    display: none;
}

/* Single soft band of light drifting downward — CRT scan effect */
.scanline-sweep {
    position: absolute;
    left: 0; right: 0;
    top: -20%;
    height: 18%;
    background-image: linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0),
        rgba(255, 255, 255, 0.022),
        rgba(255, 255, 255, 0)
    );
    animation-name: scanline-scroll;
    animation-duration: 7s;
    animation-iteration-count: infinite;
    animation-timing-function: linear;
}


/* ── Task pass stamp ─────────────────────────────────────────────── */

.task-stamp {
    display: none;
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}

.task-stamp--active {
    display: flex;
    animation-name: stamp-appear;
    animation-duration: 2.5s;
    animation-timing-function: ease-out;
    animation-iteration-count: 1;
}

.task-stamp-label {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 46px;
    color: rgba(155, 38, 38, 0.88);
    border-width: 5px;
    border-color: rgba(155, 38, 38, 0.80);
    border-radius: 5px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 24px;
    padding-right: 24px;
    letter-spacing: 8px;
    rotate: -9deg;
    -unity-font-style: bold;
}

/* ═══════════════════════════════════════════════════════════════════
   ROOT
   ═══════════════════════════════════════════════════════════════════ */

.root {
    width: 100%;
    height: 100%;
    padding: 18px;
    background-color: rgba(0, 0, 0, 0);
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
}

/* ═══════════════════════════════════════════════════════════════════
   HEADER
   ═══════════════════════════════════════════════════════════════════ */

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
}

.icon-button {
    width: 54px;
    height: 54px;
    font-size: 14px;
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    background-image: url("project://database/Assets/Textures/actual%20assets/loading%20new%20game%20-%20name/proceed%20button.png?fileID=2800000&guid=9ccb91f489f4a2a4b9757175198f434f&type=3#proceed%20button");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(212, 175, 55);
    padding: 10px;
    -unity-text-align: middle-center;
    scale: 1;
    transition-property: scale, -unity-background-image-tint-color, color;
    transition-duration: 0.15s, 0.15s, 0.15s;
    transition-timing-function: ease-out, ease-out, ease-out;
    animation-name: btn-pop;
    animation-duration: 0.28s;
    animation-timing-function: ease-out;
}

.icon-button:hover {
    -unity-background-image-tint-color: rgb(255, 238, 190);
    color: rgb(255, 224, 136);
    scale: 1.08;
}

.icon-button:active {
    scale: 0.93;
}

.btn-icon {
    flex-grow: 1;
    align-self: stretch;
    -unity-background-scale-mode: scale-to-fit;
}

/* ═══════════════════════════════════════════════════════════════════
   BURGER DROPDOWN
   ═══════════════════════════════════════════════════════════════════ */

.burger-menu-dropdown {
    position: absolute;
    top: 8px;
    left: 89px;
    flex-direction: row;
    background-color: rgba(24, 18, 16, 0.96);
    border-width: 1px;
    border-color: rgba(212, 175, 55, 0.3);
    border-radius: 6px;
    padding: 6px 8px;
    align-items: center;
    translate: 0 0;
}

/* ═══════════════════════════════════════════════════════════════════
   BUTTONS — shared base
   ═══════════════════════════════════════════════════════════════════ */

.menu-button {
    width: 54px;
    height: 54px;
    margin-right: 8px;
    margin-bottom: 0;
    padding: 10px;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    background-image: url("project://database/Assets/Textures/actual%20assets/loading%20new%20game%20-%20name/proceed%20button.png?fileID=2800000&guid=9ccb91f489f4a2a4b9757175198f434f&type=3#proceed%20button");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(212, 175, 55);
    -unity-text-align: middle-center;
    scale: 1;
    transition-property: scale, -unity-background-image-tint-color, color;
    transition-duration: 0.15s, 0.15s, 0.15s;
    transition-timing-function: ease-out, ease-out, ease-out;
    animation-name: btn-pop;
    animation-duration: 0.28s;
    animation-timing-function: ease-out;
}

.menu-button:hover {
    -unity-background-image-tint-color: rgb(255, 238, 190);
    color: rgb(255, 224, 136);
    scale: 1.08;
}

.menu-button:active {
    scale: 0.93;
}

.sql-button {
    font-size: 8px;
    letter-spacing: 0;
}

.save-exit-button {
    font-size: 7px;
    margin-right: 0;
    color: rgb(210, 110, 110);
    -unity-background-image-tint-color: rgba(180, 100, 100, 0.85);
}

.save-exit-button:hover {
    -unity-background-image-tint-color: rgba(220, 110, 110, 1.0);
    color: rgb(240, 140, 140);
    scale: 1.08;
}

.hidden {
    display: none;
}

/* legacy nav-button — unused but kept for safety */
.nav-button {
    width: 60px;
    height: 60px;
    font-size: 20px;
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    background-color: rgb(24, 18, 16);
    color: rgb(237, 224, 220);
    border-color: rgba(212, 175, 55, 0.40);
    border-width: 1px;
    border-radius: 3px;
    position: absolute;
    top: 50%;
    margin-top: -30px;
    -unity-text-align: middle-center;
}
.middle-left  { left:  20px; }
.middle-right { right: 20px; }

/* ═══════════════════════════════════════════════════════════════════
   CUTSCENE OVERLAY
   ═══════════════════════════════════════════════════════════════════ */

.cutscene-layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(14, 10, 8, 0.90);
    display: none;
}

.cutscene-text {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 25px;
    color: rgb(237, 224, 220);
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 680px;
    margin-bottom: 40px;
    padding-left: 40px;
    padding-right: 40px;
    letter-spacing: 1px;
    -unity-text-shadow: 0px 1px 4px rgba(0, 0, 0, 0.6);
}

.cutscene-continue {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 20px;
    letter-spacing: 2px;
    color: rgb(242, 202, 80);
    background-color: rgba(40, 32, 28, 0.85);
    border-top-color: rgba(255, 224, 136, 0.75);
    border-bottom-color: rgba(212, 175, 55, 0.35);
    border-left-color: rgba(212, 175, 55, 0.35);
    border-right-color: rgba(212, 175, 55, 0.35);
    border-width: 1px;
    border-radius: 3px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 26px;
    padding-right: 26px;
    scale: 1;
    transition-property: scale, background-color, border-top-color, color;
    transition-duration: 0.15s, 0.15s, 0.15s, 0.15s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}

.cutscene-continue:hover {
    background-color: rgba(58, 48, 40, 0.90);
    border-top-color: rgb(255, 224, 136);
    color: rgb(255, 224, 136);
    scale: 1.06;
}

/* ── Image cutscene — fullscreen art with subtitle text ──────────────────── */
.cutscene-layer--image {
    background-color: rgba(0, 0, 0, 0);
    justify-content: flex-end;
    align-items: stretch;
    -unity-background-scale-mode: scale-and-crop;
}

.cutscene-img-debbiepoof {
    background-image: url("project://database/Assets/Textures/cutscenes/debbiepoof.png?fileID=2800000&guid=608e6966c4a96d643b0bdb36071dc947&type=3#debbiepoof");
    -unity-background-scale-mode: scale-and-crop;
}

.cutscene-img-wormhole {
    background-image: url("project://database/Assets/Textures/cutscenes/jumping%20wormhole.png?fileID=2800000&guid=e5974929f9441384ebad9cea4895986c&type=3#jumping%20wormhole");
    -unity-background-scale-mode: scale-and-crop;
}

.cutscene-text--subtitle {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 20px;
    color: rgb(237, 224, 220);
    white-space: normal;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.65);
    max-width: none;
    width: 100%;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 40px;
    padding-right: 40px;
    margin-bottom: 0;
    letter-spacing: 1px;
}

.dialogue-layer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    height: 320px;
    flex-direction: row;
    align-items: flex-end;
    display: none;
    overflow: visible;
}

.speaker-portrait {
    position: absolute;
    bottom: -100px;
    left: 15px;
    width: 360px;
    height: 480px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.dialogue-box {
    flex-grow: 1;
    margin-left: 300px;
    margin-right: 30px;
    margin-bottom: 20px;
    background-image: url("project://database/Assets/Textures/actual%20assets/Untitled39_0001_Speech-Bubble.png?fileID=2800000&guid=d9ae14ae8e5cd6a46a41a0bf5033140d&type=3#Untitled39_0001_Speech-Bubble");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 48px;
    padding-right: 32px;
}

.speaker-name {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 13px;
    color: rgb(140, 100, 28);
    -unity-font-style: bold;
    margin-bottom: 10px;
    letter-spacing: 2px;
    -unity-text-shadow: 0px 1px 2px rgba(255, 200, 80, 0.3);
}

.dialogue-text {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 15px;
    color: rgb(42, 28, 14);
    white-space: normal;
    flex-grow: 1;
    margin-bottom: 12px;
    -unity-text-shadow: 0px 1px 3px rgba(0, 0, 0, 0.35);
}

/* Continue button — blinks slowly to signal it's clickable */
.continue-btn {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(212, 175, 55);
    background-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(242, 202, 80, 0.55);
    border-bottom-color: rgba(212, 175, 55, 0.20);
    border-left-color: rgba(212, 175, 55, 0.20);
    border-right-color: rgba(212, 175, 55, 0.20);
    border-width: 1px;
    border-radius: 3px;
    align-self: flex-end;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 14px;
    padding-right: 14px;
    animation-name: continue-blink;
    animation-duration: 2.8s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    scale: 1;
    transition-property: scale, color, border-top-color;
    transition-duration: 0.12s, 0.12s, 0.12s;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.continue-btn:hover {
    color: rgb(255, 224, 136);
    border-top-color: rgb(255, 224, 136);
    opacity: 1;
    scale: 1.06;
}

.task-banner {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    background-color: rgb(32, 26, 22);
    border-bottom-color: rgb(212, 175, 55);
    border-bottom-width: 2px;
    border-width: 0;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    display: none;
    animation-name: banner-rise;
    animation-duration: 0.35s;
    animation-timing-function: ease-out;
}

.task-label {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 14px;
    color: rgb(242, 202, 80);
    white-space: normal;
    flex-grow: 1;
    letter-spacing: 1px;
    -unity-text-shadow: 0px 1px 3px rgba(0, 0, 0, 0.5);
}

.debbie-hint-btn {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(212, 175, 55);
    background-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(242, 202, 80, 0.55);
    border-bottom-color: rgba(212, 175, 55, 0.22);
    border-left-color: rgba(212, 175, 55, 0.22);
    border-right-color: rgba(212, 175, 55, 0.22);
    border-width: 1px;
    border-radius: 3px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    flex-shrink: 0;
    animation-name: debbie-pulse;
    animation-duration: 3.5s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    scale: 1;
    transition-property: scale, background-color, border-top-color, color;
    transition-duration: 0.12s, 0.12s, 0.12s, 0.12s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}

.debbie-hint-btn:hover {
    background-color: rgba(242, 202, 80, 0.12);
    border-top-color: rgb(255, 224, 136);
    border-bottom-color: rgba(242, 202, 80, 0.55);
    border-left-color: rgba(242, 202, 80, 0.55);
    border-right-color: rgba(242, 202, 80, 0.55);
    color: rgb(255, 224, 136);
    opacity: 1;
    scale: 1.06;
}

/* ═══════════════════════════════════════════════════════════════════
   DEBBIE HINT POPUP
   ═══════════════════════════════════════════════════════════════════ */

.hint-popup {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    background-color: rgba(30, 24, 20, 0.99);
    border-top-color: rgb(242, 202, 80);
    border-bottom-color: rgba(212, 175, 55, 0.40);
    border-left-color: rgba(212, 175, 55, 0.55);
    border-right-color: rgba(212, 175, 55, 0.30);
    border-width: 1px;
    border-radius: 3px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 18px;
    padding-right: 18px;
    display: none;
    animation-name: hint-breathe;
    animation-duration: 4s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
}

.hint-popup-speaker {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 17px;
    color: rgb(242, 202, 80);
    margin-bottom: 8px;
    letter-spacing: 2px;
}

.hint-popup-text {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 17px;
    color: rgb(237, 224, 220);
    white-space: normal;
    flex-grow: 1;
    margin-bottom: 12px;
    -unity-text-shadow: 0px 1px 3px rgba(0, 0, 0, 0.55);
}

.hint-popup-close {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(212, 175, 55);
    background-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(242, 202, 80, 0.55);
    border-bottom-color: rgba(212, 175, 55, 0.20);
    border-left-color: rgba(212, 175, 55, 0.20);
    border-right-color: rgba(212, 175, 55, 0.20);
    border-width: 1px;
    border-radius: 3px;
    align-self: flex-end;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 14px;
    padding-right: 14px;
    scale: 1;
    transition-property: scale, background-color, border-top-color, color;
    transition-duration: 0.12s, 0.12s, 0.12s, 0.12s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}

.hint-popup-close:hover {
    background-color: rgba(242, 202, 80, 0.12);
    border-top-color: rgb(255, 224, 136);
    color: rgb(255, 224, 136);
    opacity: 1;
    scale: 1.06;
}

/* ═══════════════════════════════════════════════════════════════════
   INVENTORY PANEL
   ═══════════════════════════════════════════════════════════════════ */

.inventory-panel {
    position: absolute;
    left: 20px;
    top: 90px;
    width: 280px;
    height: 480px;
    background-color: rgba(40, 32, 28, 0.98);
    border-top-color: rgba(242, 202, 80, 0.75);
    border-bottom-color: rgba(212, 175, 55, 0.20);
    border-left-color: rgba(212, 175, 55, 0.35);
    border-right-color: rgba(212, 175, 55, 0.20);
    border-width: 1px;
    border-radius: 3px;
    padding: 16px;
    display: none;
}

.inventory-title {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 11px;
    color: rgb(242, 202, 80);
    -unity-text-align: upper-center;
    letter-spacing: 3px;
    margin-bottom: 12px;
    border-bottom-color: rgba(212, 175, 55, 0.35);
    border-bottom-width: 1px;
    padding-bottom: 10px;
}

.inventory-list {
    flex-grow: 1;
    margin-bottom: 10px;
}

.inventory-action-btn {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 9px;
    letter-spacing: 1px;
    color: rgb(175, 162, 148);
    background-color: rgb(28, 22, 18);
    border-top-color: rgba(212, 175, 55, 0.40);
    border-bottom-color: rgba(212, 175, 55, 0.12);
    border-left-color: rgba(212, 175, 55, 0.12);
    border-right-color: rgba(212, 175, 55, 0.12);
    border-width: 1px;
    border-radius: 3px;
    height: 36px;
    margin-top: 6px;
    scale: 1;
    transition-property: scale, background-color, border-top-color, color;
    transition-duration: 0.12s, 0.12s, 0.12s, 0.12s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}

.inventory-action-btn:hover {
    background-color: rgba(242, 202, 80, 0.10);
    border-top-color: rgba(242, 202, 80, 0.80);
    border-bottom-color: rgba(212, 175, 55, 0.40);
    border-left-color: rgba(212, 175, 55, 0.40);
    border-right-color: rgba(212, 175, 55, 0.40);
    color: rgb(242, 202, 80);
    scale: 1.03;
}

.inventory-hud-btn {
    width: 54px;
    height: 54px;
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 10px;
    color: rgb(212, 175, 55);
    background-image: url("project://database/Assets/Textures/actual%20assets/loading%20new%20game%20-%20name/proceed%20button.png?fileID=2800000&guid=9ccb91f489f4a2a4b9757175198f434f&type=3#proceed%20button");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding: 10px;
    -unity-text-align: middle-center;
    margin-right: 6px;
    scale: 1;
    transition-property: scale, -unity-background-image-tint-color, color;
    transition-duration: 0.15s, 0.15s, 0.15s;
    transition-timing-function: ease-out, ease-out, ease-out;
    animation-name: btn-pop;
    animation-duration: 0.28s;
    animation-timing-function: ease-out;
}

.inventory-hud-btn:hover {
    -unity-background-image-tint-color: rgb(255, 238, 190);
    color: rgb(255, 224, 136);
    scale: 1.08;
}

.inventory-hud-btn:active {
    scale: 0.93;
}

.header-right {
    flex-direction: row;
    align-items: flex-start;
}

.sql-input-panel {
    background-color: rgb(18, 14, 12);
    border-right-color: rgba(212, 175, 55, 0.28);
    border-right-width: 1px;
}

.sql-input-row {
    border-bottom-color: rgba(212, 175, 55, 0.25);
    border-bottom-width: 1px;
}

.sql-input-field {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 14px;
    color: rgb(237, 224, 220);
    background-color: rgb(20, 16, 13);
    border-top-color: rgba(212, 175, 55, 0.28);
    border-bottom-color: rgba(212, 175, 55, 0.08);
    border-left-color: rgba(212, 175, 55, 0.08);
    border-right-color: rgba(212, 175, 55, 0.08);
    border-width: 1px;
    border-radius: 0;
}

.sql-input-field .unity-base-text-field__input {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 14px;
    color: rgb(237, 224, 220);
    background-color: rgb(20, 16, 13);
    border-width: 0;
}

.sql-input-field .unity-base-text-field__input:focus {
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
}

.sql-history-list {
    background-color: rgb(14, 10, 8);
}

.sql-send-btn {
    width: 80px;
    height: 100%;
    flex-shrink: 0;
    margin: 0;
    font-size: 13px;
    letter-spacing: 1px;
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    background-color: rgb(212, 175, 55);
    color: rgb(22, 16, 0);
    border-top-color: rgba(255, 240, 160, 0.90);
    border-bottom-color: rgba(130, 100, 18, 0.80);
    border-left-color: rgba(180, 145, 40, 0.60);
    border-right-color: rgba(180, 145, 40, 0.60);
    border-width: 1px;
    border-radius: 0;
    -unity-text-align: middle-center;
    scale: 1;
    transition-property: background-color, color, border-top-color, scale;
    transition-duration: 0.12s, 0.12s, 0.12s, 0.12s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}

.sql-send-btn:hover {
    background-color: rgb(242, 202, 80);
    color: rgb(14, 10, 0);
    border-top-color: rgb(255, 248, 200);
}

.sql-send-btn:active {
    background-color: rgb(180, 145, 38);
    scale: 0.97;
}

.sql-output-panel {
    background-color: rgb(15, 11, 9);
}

.sql-output-text {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 14px;
    color: rgb(200, 175, 130);
    white-space: normal;
}

