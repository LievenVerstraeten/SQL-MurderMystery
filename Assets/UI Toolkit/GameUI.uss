/* ═══════════════════════════════════════════════════════════════════
   TUTORIAL OVERLAY
   ═══════════════════════════════════════════════════════════════════ */

.tutorial-header {
    flex-direction: row;
    align-items: center;
    padding: 10px 16px;
    background-color: rgba(38, 24, 8, 1);
    flex-shrink: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgb(140, 100, 28);
}

.tutorial-title {
    flex-grow: 1;
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 20px;
    color: rgb(140, 100, 28);
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.tutorial-close-btn {
    width: 44px;
    height: 44px;
    background-image: url('project://database/Assets/Textures/actual%20assets/clue%20board/Untitled39_0000s_0000_Button-Close.png?fileID=2800000&guid=653d1e86460b90649bc7cbc2b3bb651b&type=3#Untitled39_0000s_0000_Button-Close');
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.tutorial-content {
    padding-top: 28px;
    padding-bottom: 40px;
    padding-left: 64px;
    padding-right: 64px;
    max-width: 740px;
    align-self: center;
    width: 100%;
}

.tutorial-section-title {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 18px;
    color: rgb(242, 202, 80);
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-top: 28px;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(212, 175, 55, 0.28);
    padding-bottom: 6px;
}

.tutorial-body {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 17px;
    color: rgb(205, 193, 172);
    white-space: normal;
    margin-bottom: 10px;
}

.tutorial-divider {
    height: 1px;
    background-color: rgba(212, 175, 55, 0.12);
    margin-top: 10px;
    margin-bottom: 2px;
}

.tutorial-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.04);
}

.tutorial-key {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 18px;
    color: rgb(212, 175, 55);
    -unity-font-style: bold;
    width: 130px;
    flex-shrink: 0;
    letter-spacing: 1px;
    padding-top: 1px;
}

.tutorial-val {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 17px;
    color: rgb(205, 193, 172);
    white-space: normal;
    flex-grow: 1;
}

/* ── Tutorial scrollbar ──────────────────────────────────────────────────── */
.tutorial-scroll .unity-scroller--vertical {
    background-color: rgba(20, 14, 6, 0.9);
    border-left-color: rgba(140, 100, 28, 0.5);
    border-left-width: 1px;
    width: 12px;
}

.tutorial-scroll .unity-scroller__low-button,
.tutorial-scroll .unity-scroller__high-button {
    background-color: rgba(140, 100, 28, 0.3);
    border-color: rgba(140, 100, 28, 0.5);
    border-width: 1px;
}

.tutorial-scroll .unity-base-slider__tracker {
    background-color: rgba(140, 100, 28, 0.15);
}

.tutorial-scroll .unity-base-slider__dragger {
    background-color: rgb(140, 100, 28);
    border-radius: 4px;
    border-width: 0;
    margin-left: 2px;
    margin-right: 2px;
}
/* ═══════════════════════════════════════════════════════════════════
   PROFILE OVERLAY
   ═══════════════════════════════════════════════════════════════════ */

/* Board card — uses the corkboard image as background */
.profile-card {
    width: 960px;
    height: 580px;
    background-image: url("project://database/Assets/Textures/actual%20assets/clue%20board/example%20of%20how%20it%20looks.png?fileID=2800000&guid=c2bd95316f279694aaeada7eee7fa241&type=3#example%20of%20how%20it%20looks");
    -unity-background-scale-mode: stretch-to-fill;
    flex-direction: row;
    padding-top: 80px;
    padding-bottom: 50px;
    padding-left: 60px;
    padding-right: 60px;
    align-items: stretch;
}

/* Left column: avatar + name */
.profile-left {
    width: 220px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    padding-bottom: 80px;
}

.profile-avatar {
    width: 140px;
    height: 140px;
    background-image: url("project://database/Assets/Textures/actual%20assets/profile_icon.png");
    -unity-background-scale-mode: scale-to-fit;
    border-radius: 60px;
    margin-bottom: 12px;
}

.profile-avatar-name {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 14px;
    color: rgb(242, 202, 80);
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.profile-avatar-status {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 14px;
    color: rgb(120, 190, 110);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

/* Vertical rule between columns */
.profile-vdivider {
    width: 1px;
    background-color: rgba(212, 175, 55, 0.30);
    margin-left: 18px;
    margin-right: 22px;
    flex-shrink: 0;
}

/* Right column: dossier text */
.profile-right {
    flex-grow: 1;
    flex-direction: column;
}

.profile-dossier-title {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 16px;
    color: rgb(140, 100, 28);
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(212, 175, 55, 0.25);
    padding-bottom: 6px;
}

.profile-info-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 7px;
}

.profile-info-key {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 15px;
    color: rgb(175, 148, 80);
    -unity-font-style: bold;
    width: 140px;
    flex-shrink: 0;
    letter-spacing: 1px;
    padding-top: 1px;
}

.profile-info-val {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 14px;
    color: rgb(210, 198, 175);
    white-space: normal;
    flex-grow: 1;
}

.profile-notes-divider {
    height: 1px;
    background-color: rgba(212, 175, 55, 0.18);
    margin-top: 6px;
    margin-bottom: 10px;
}

.profile-notes-title {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 15px;
    color: rgb(175, 148, 80);
    letter-spacing: 2px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.profile-notes-body {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 14px;
    color: rgb(190, 178, 155);
    white-space: normal;
    flex-grow: 1;
    max-width: 85%;
}

/* Dismiss button below the card */
.profile-close-btn {
    -unity-font: url("project://database/Assets/Fonts/SpecialElite.ttf");
    font-size: 16px;
    letter-spacing: 2px;
    color: rgb(175, 162, 148);
    background-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(212, 175, 55, 0.35);
    border-bottom-color: rgba(212, 175, 55, 0.10);
    border-left-color: rgba(212, 175, 55, 0.10);
    border-right-color: rgba(212, 175, 55, 0.10);
    border-width: 1px;
    border-radius: 3px;
    margin-top: 18px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 30px;
    padding-right: 30px;
    scale: 1;
    transition-property: scale, color, border-top-color;
    transition-duration: 0.12s, 0.12s, 0.12s;
    transition-timing-function: ease-out, ease-out, ease-out;
}

.profile-close-btn:hover {
    color: rgb(242, 202, 80);
    border-top-color: rgba(242, 202, 80, 0.70);
    scale: 1.05;
}


    /* ── Text cursor / caret — visible in all text fields ───────────────────── */
TextInput {
    -unity-cursor-color: rgb(242, 202, 80);
}

TextField > .unity-base-text-field__input {
    -unity-cursor-color: rgb(242, 202, 80);
}

.card-edit-field > .unity-base-field__input {
    -unity-cursor-color: rgb(242, 202, 80);
}

    /* ── Dialogue History Overlay ───────────────────────────────────────────── */
.history-header {
    flex-direction: row;
    align-items: center;
    padding: 16px 22px;
    background-color: rgba(20, 14, 6, 1.0);
    flex-shrink: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgb(140, 100, 28);
}

.history-title {
    flex-grow: 1;
    font-size: 20px;
    color: rgb(140, 100, 28);
    -unity-font-style: bold;
}

.history-scroll {
    flex-grow: 1;
    padding: 16px 24px;
}

.history-content {
    flex-direction: column;
}

.history-entry {
    flex-direction: column;
    margin-bottom: 16px;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(140, 100, 28, 0.2);
}

.history-speaker {
    font-size: 18px;
    color: rgb(140, 100, 28);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.history-text {
    font-size: 16px;
    color: rgb(200, 185, 160);
    white-space: normal;
}

.history-scroll .unity-scroller--vertical {
    background-color: rgba(20, 14, 6, 0.9);
    border-left-color: rgba(140, 100, 28, 0.5);
    border-left-width: 1px;
    width: 12px;
}

.history-scroll .unity-scroller__low-button,
.history-scroll .unity-scroller__high-button {
    background-color: rgba(140, 100, 28, 0.3);
    border-color: rgba(140, 100, 28, 0.5);
    border-width: 1px;
}

.history-scroll .unity-base-slider__tracker {
    background-color: rgba(140, 100, 28, 0.15);
}

.history-scroll .unity-base-slider__dragger {
    background-color: rgb(140, 100, 28);
    border-radius: 4px;
    border-width: 0;
    margin-left: 2px;
    margin-right: 2px;
}