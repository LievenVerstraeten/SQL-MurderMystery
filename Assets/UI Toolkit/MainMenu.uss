/*
 * MainMenu.uss — Queryhound SQL Murder Mystery
 */

@keyframes logo-appear {
    0%   { opacity: 0; translate: 0 -20px; }
    100% { opacity: 1; translate: 0 0; }
}

@keyframes button-rise {
    0%   { opacity: 0; translate: 0 24px; }
    45%  { opacity: 0; translate: 0 24px; }
    100% { opacity: 1; translate: 0 0; }
}

/* ═══════════════════════════════════════════════════════════════════
   ROOT & BACKGROUND LAYER
   ═══════════════════════════════════════════════════════════════════ */

.root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    overflow: hidden;
}

/* Oversized so parallax shift never reveals an edge */
.bg-layer {
    position: absolute;
    left: -40px;
    top: -40px;
    right: -40px;
    bottom: -40px;
    background-image: url("project://database/Assets/Textures/actual%20assets/mainscreen/Untitled39_0002s_0003_Main-Menu-Screen.png?fileID=2800000&guid=ffdcb08bcb8ab824ba5b2de34a8b1630&type=3#Untitled39_0002s_0003_Main-Menu-Screen");
    -unity-background-scale-mode: scale-and-crop;
}

/* ═══════════════════════════════════════════════════════════════════
   LOGO
   ═══════════════════════════════════════════════════════════════════ */

.logo-wrap {
    width: 620px;
    height: 186px;
    margin-bottom: 36px;
    animation-name: logo-appear;
    animation-duration: 0.85s;
    animation-timing-function: ease-out;
}

/* Same dimensions as logo, offset slightly down to cast shadow beneath */
.logo-shadow {
    position: absolute;
    left: 0;
    top: 12px;
    width: 620px;
    height: 186px;
    background-image: url("project://database/Assets/Textures/actual%20assets/mainscreen/Untitled39_0002s_0002_Logo-Main-Menu-Shadow.png?fileID=2800000&guid=47b19c7c7a35f264d80ff075a4c16c3d&type=3#Untitled39_0002s_0002_Logo-Main-Menu-Shadow");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.5;
}

.logo {
    position: absolute;
    left: 0;
    top: 0;
    width: 620px;
    height: 186px;
    background-image: url("project://database/Assets/Textures/actual%20assets/mainscreen/Untitled39_0002s_0001_Logo-Main-Menu.png?fileID=2800000&guid=6f50584856cf9244ab52df0a841293e4&type=3#Untitled39_0002s_0001_Logo-Main-Menu");
    -unity-background-scale-mode: scale-to-fit;
}

/* ═══════════════════════════════════════════════════════════════════
   BUTTON CONTAINER
   ═══════════════════════════════════════════════════════════════════ */

.button-container {
    align-items: center;
    flex-direction: column;
    animation-name: button-rise;
    animation-duration: 1.0s;
    animation-timing-function: ease-out;
}

/* ═══════════════════════════════════════════════════════════════════
   BUTTONS — shared base
   ═══════════════════════════════════════════════════════════════════ */

.menu-btn {
    width: 390px;
    height: 76px;
    padding: 0;
    font-size: 25px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(48, 28, 14);
    background-image: url("project://database/Assets/Textures/actual%20assets/mainscreen/Untitled39_0002s_0005_Speech-Bubble.png?fileID=2800000&guid=e2c4f87c83c17a44296424af44d9b995&type=3#Untitled39_0002s_0005_Speech-Bubble");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    margin-bottom: 4px;
    scale: 1;
    transition-property: scale, rotate, -unity-background-image-tint-color, color;
    transition-duration: 0.22s, 0.22s, 0.22s, 0.22s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out;
}

/* ─── Per-button tilt (vintage feel) ───────────────────────────── */

#play-button     { rotate: -2.2deg; }
#settings-button { rotate:  1.5deg; }
#credits-button  { rotate: -1.8deg; }
#exit-button     { rotate:  2.0deg; }

/* ─── Hover: straighten + lift ─────────────────────────────────── */

.menu-btn:hover {
    scale: 1.06;
    rotate: 0deg;
    -unity-background-image-tint-color: rgb(255, 244, 210);
    color: rgb(25, 10, 2);
}

.menu-btn:active {
    scale: 0.96;
    rotate: 0deg;
    -unity-background-image-tint-color: rgb(195, 178, 148);
}

/* Exit gets a subtle red tint */
.exit-btn { color: rgb(110, 28, 18); }

.exit-btn:hover {
    -unity-background-image-tint-color: rgb(255, 215, 205);
    color: rgb(150, 28, 18);
}

/* ═══════════════════════════════════════════════════════════════════
   CREDITS PANEL
   ═══════════════════════════════════════════════════════════════════ */

.credits-panel {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(12, 9, 7, 0.97);
    align-items: center;
    justify-content: center;
}

.credits-heading {
    font-size: 22px;
    color: rgb(242, 202, 80);
    letter-spacing: 5px;
    -unity-text-align: upper-center;
    padding-bottom: 16px;
    border-bottom-color: rgba(212, 175, 55, 0.45);
    border-bottom-width: 1px;
    margin-bottom: 32px;
}

.credits-name {
    font-size: 14px;
    color: rgb(237, 224, 220);
    letter-spacing: 2px;
    -unity-text-align: upper-center;
    margin-bottom: 14px;
}

.credits-name--last {
    margin-bottom: 40px;
}
